# BARRY Environment Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./barry.db
ROBOT_MODE=simulation # laptop-local /api/robot mode: simulator, remote, dogzilla
# Quest /api/v1 robot requests are always relayed by the laptop to this Pi API.
ROBOT_REMOTE_URL=http://barry-pi.local:8100
ROBOT_API_KEY=
# Laptop-side key required from the Quest on every /api/v1 robot relay route.
# Set this to the same value as robotApiKey in the Quest's BarryConfig.
QUEST_API_KEY=
ROBOT_REMOTE_TIMEOUT=0.5
# Priority stop/e-stop HTTP timeout; clamped to 0.1-2.0 seconds (default 0.3).
ROBOT_STOP_TIMEOUT_S=0.3
ENVIRONMENT=development
LOG_LEVEL=info

# AI & LLM Provider Configuration
# Options: openrouter, mock, openai, anthropic, google, local
# If LLM_PROVIDER is left blank and OPENROUTER_API_KEY is empty, BARRY starts in 'mock' mode automatically.
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-4o-mini
FALLBACK_LLM_PROVIDER=mock

# OpenRouter (Initial Gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct API Providers (Optional Extensions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Local Inference / NVIDIA DGX Spark (OpenAI-Compatible Endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local-dgx
LOCAL_LLM_MODEL=llama3.1:8b

# AI Request Reliability Settings
AI_TIMEOUT=30
AI_MAX_RETRIES=2

# Laptop relay continuous motion (backend/robot/relay_router.py)
# Keep repeating the last Quest motion command so a brief Wi-Fi gap doesn't stutter the robot; then stop.
ROBOT_CONTINUOUS_MOTION=true
# Seconds after the last real Quest motion command before the relay stops the robot.
# Default 1.0; clamped to 0.2-2.0 (invalid values fall back to the default).
ROBOT_CONTINUOUS_MOTION_WINDOW_S=1.0

# Security & Testing Access Controls
# Set REQUIRE_ACTIVE_MISSION=false to allow voice, LLM, and VR motions without starting a mission first.
REQUIRE_ACTIVE_MISSION=false
# Set AUTH_ALLOW_UNREGISTERED_TAGS=true to auto-provision any scanned card or tag UID for instant testing.
AUTH_ALLOW_UNREGISTERED_TAGS=true
QUEST_API_KEY_ALLOW_ANONYMOUS=true
CAMERA_API_KEY_ALLOW_ANONYMOUS=true

# Dog camera relay for /api/camera/stream (Yahboom MJPEG). Default: port 6500 on the ROBOT_REMOTE_URL host.
# DOG_VIDEO_URL=http://192.168.0.174:6500/video_feed
