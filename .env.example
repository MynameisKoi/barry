# BARRY Environment Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./barry.db
ROBOT_MODE=simulation # laptop-local /api/robot mode: simulator, remote, dogzilla
# Quest /api/v1 robot requests are always relayed by the laptop to this Pi API.
ROBOT_REMOTE_URL=http://barry-pi.local:8100
ROBOT_API_KEY=
# Laptop-side key required from the Quest on every /api/v1 robot relay route.
# Set this to the same value as apiKey in the Quest's BarryConfig.
QUEST_API_KEY=
ROBOT_REMOTE_TIMEOUT=0.5
ENVIRONMENT=development
LOG_LEVEL=info

# AI & LLM Provider Configuration
# Options: openrouter, mock, openai, anthropic, google, local
# If LLM_PROVIDER is left blank and OPENROUTER_API_KEY is empty, BARRY starts in 'mock' mode automatically.
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-4o-mini
FALLBACK_LLM_PROVIDER=mock

# OpenRouter (Initial Gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct API Providers (Optional Extensions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Local Inference / NVIDIA DGX Spark (OpenAI-Compatible Endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local-dgx
LOCAL_LLM_MODEL=llama3.1:8b

# AI Request Reliability Settings
AI_TIMEOUT=30
AI_MAX_RETRIES=2
