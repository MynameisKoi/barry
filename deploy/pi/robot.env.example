# Installed as /etc/barry/robot.env (mode 0640, owner root, group barry-robot).
# Names and defaults match backend/robot/config.py (RobotConfig.from_env).
# Empty values:
# - ROBOT_WATCHDOG_MS, ROBOT_SESSION_TTL_S, ROBOT_MAX_COMMAND_AGE_MS: an empty
#   value falls back to the default shown in its comment.
# - ROBOT_MODE: must be set. An empty value fails startup.
# - DOGZILLA_PORT: do not leave it empty. An empty value is used as-is (not the
#   default), so keep /dev/ttyAMA0 or set your port.
# - ROBOT_API_KEY: must be set. In dogzilla mode an empty value makes the app
#   fail on its first request (including /healthz) with "ROBOT_API_KEY is
#   required in dogzilla mode", visible in journalctl, not as a 401.

# simulator | remote | dogzilla. Use dogzilla on the Pi.
ROBOT_MODE=dogzilla

# Shared secret sent by the laptop in the X-Robot-Key header. Required.
# Generate one with: openssl rand -hex 32
ROBOT_API_KEY=

# Pi camera settings. Camera access currently reuses ROBOT_API_KEY; the Pi app
# has one auth hook where ROBOT_EMERGENCY_KEY can be introduced in Phase 4.
CAMERA_ENABLED=true
CAMERA_DEVICE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_TARGET_FPS=15
CAMERA_MAX_VIEWERS=3
CAMERA_STALL_TIMEOUT_S=2

# Serial device for the DOGZILLA S2 board. Default: /dev/ttyAMA0
DOGZILLA_PORT=/dev/ttyAMA0

# Stop the robot if no motion command arrives for this long, in ms. Default: 500
ROBOT_WATCHDOG_MS=500

# Idle control session expiry, in seconds. Default: 10
ROBOT_SESSION_TTL_S=10

# Reject commands older than this (sender clock), in ms. 0 disables. Default: 0
# Only enable when the laptop and Pi both run NTP.
ROBOT_MAX_COMMAND_AGE_MS=0
